# Copy this file to `.env` and fill in your own credentials.
# `.env` is git-ignored and must never be committed.

# --- Google Gemini: Stage 1 (describe), Stage 2 (classify), dunk extraction ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- Anthropic Claude: independent validation pass (classify_val_claude.py) ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- ACRCloud: music identification (music_id.py) ---
# Free "Audio & Video Recognition" project at https://www.acrcloud.com
ACRCLOUD_HOST=identify-xx-xxxx-1.acrcloud.com
ACRCLOUD_ACCESS_KEY=your-acrcloud-access-key
ACRCLOUD_ACCESS_SECRET=your-acrcloud-access-secret
